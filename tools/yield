#!/bin/bash
# Benches yield to the person at the screen. Every run of these tools that
# draws on the GPU (previews, benches, the hidden desktop, theme previews,
# fresh-user, smoothness) goes through here: each tool, started outside it,
# starts again inside it.
#
#   tools/yield <command> [args...]       runs it now if it fits, else queues it
#   tools/yield --queue <command> [args]  queues it
#
# Someone is at the screen unless their session is locked or every monitor
# sleeps (read from logind and Hyprland, never changed). While someone is, a
# run has 15 s with its teardown and at most 1440x900, and the next run starts
# no sooner than as long again after it ends. While nobody is, a run has 20
# minutes and ends the moment someone is back. Every run is alone (one lock),
# at the lowest CPU and disk priority, in a cgroup of its own, and every
# process it started ends with it. A run that does not fit (more than
# 1440x900, past its 15 s, or someone came back to it) waits in the queue and
# exits 75; the queue runs, in order, whenever nobody is at the screen.
#
#   tools/yield --within [WxH]   for the tools: 1 outside any run; in one, 0
#                                when WxH fits it, else 75 (and it is queued)
#
# In ${XDG_STATE_HOME:-~/.local/state}/omarchy-cinema/bench: log, a line a
# run; queue/, a file a waiting run (its directory, environment and
# arguments, as at(1) keeps them); out/, what each queued run printed. The
# queue's runner is a user unit, omarchy-cinema-bench, started by the first
# run queued and by any run while one waits; it waits out an empty queue.
set -uo pipefail

door=$(realpath "$0")
state=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-cinema/bench
runs=$XDG_RUNTIME_DIR/omarchy-cinema-bench
mkdir -p "$state/queue" "$state/out" "$runs"

# A process's start time (which tells it from a later one with its PID) and
# its parent.
proc() { local s; read -r s 2>/dev/null <"/proc/$1/stat" || return 1; s=(${s##*) }); echo "${s[19]} ${s[1]}"; }

# The run this process is in, from its ancestors: the run's PID and largest
# size (none while nobody is at the screen).
within() {
  local pid=$PPID start parent mine size
  while ((pid > 1)) && read -r start parent < <(proc "$pid"); do
    if read -r mine size 2>/dev/null <"$runs/$pid" && [[ $mine == "$start" ]]; then run=$pid max=$size; return 0; fi
    pid=$parent
  done
  return 1
}

present() {
  local session
  session=$(loginctl show-user "$(id -un)" -p Display --value 2>/dev/null)
  [[ -n $session && $(loginctl show-session "$session" -p LockedHint --value 2>/dev/null) == yes ]] && return 1
  [[ $(hyprctl -j monitors 2>/dev/null | jq '[.[] | select(.dpmsStatus)] | length' 2>/dev/null) != 0 ]]
}

# The queue's runner, unless it runs.
arm() {
  systemctl --user -q is-active omarchy-cinema-bench ||
    systemd-run --user -q --collect --unit=omarchy-cinema-bench "$door" --runner 2>/dev/null
}

# Published whole: the runner never sees half a file.
enqueue() {
  local envs name
  mapfile -d '' -t envs < <(env -0)
  name=$(date +%s%N)
  printf '%s\0' "$PWD" "${#envs[@]}" "${envs[@]}" "$@" >"$state/new.$name" && mv "$state/new.$name" "$state/queue/$name"
  arm
  echo "yield: queued, to run once nobody is at the screen: $*" >&2
}

# One run under the lock: its status, or 75 when it waits in the queue
# (QUEUED: it is the queue's own, so it stays where it is).
run() {
  local queued=$1 id=$BASHPID who=away max="" limit=1200 why="" status gap start took t0
  shift
  exec 9>/tmp/omarchy-cinema-hidden.lock
  flock 9
  read -r gap 2>/dev/null <"$runs/gap" && ((gap > EPOCHSECONDS)) && sleep $((gap - EPOCHSECONDS))
  present && who=present max=1440x900 limit=12
  [[ $who == present && -n $queued ]] && return 75
  read -r start _ < <(proc "$id")
  echo "$start $max" >"$runs/$id"
  trap 'systemctl --user stop "omarchy-cinema-bench-'"$id"'.scope" 2>/dev/null; rm -f "'"$runs/$id"'" "'"$runs/$id"'.waits"' EXIT
  trap exit INT TERM HUP
  # Should the door itself be ended, the gap is as long as a whole run.
  [[ $who == present ]] && echo $((EPOCHSECONDS + 30)) >"$runs/gap"
  start=${EPOCHREALTIME/./} t0=$EPOCHSECONDS
  # Its cgroup ends it at its limit (TERM, then KILL 2 s on), whatever becomes
  # of this door; it dies with the door; and it holds the lock (fd 9) until
  # its last process ends.
  systemd-run --user --scope -q --collect --unit="omarchy-cinema-bench-$id" -p RuntimeMaxSec=$limit -p TimeoutStopSec=2 -- \
    setpriv --pdeathsig KILL nice -n 19 ionice -c 3 "$@" &
  local job=$!
  while sleep 0.5; kill -0 "$job" 2>/dev/null; do
    [[ $who == away ]] && present && { why=back; break; }
  done
  systemctl --user stop "omarchy-cinema-bench-$id.scope" 2>/dev/null
  wait "$job" 2>/dev/null
  status=$?
  took=$(((${EPOCHREALTIME/./} - start) / 100000))
  [[ -z $why ]] && ((took >= limit * 10)) && { [[ $who == present ]] && why=capped || why=deadline; }
  [[ $who == present ]] && echo $((EPOCHSECONDS + took / 10 + 1)) >"$runs/gap"
  [[ -e $runs/$id.waits ]] && why=waits
  rm -f "$runs/$id" "$runs/$id.waits"
  trap - EXIT INT TERM HUP
  exec 9>&-
  printf '%(%F %T)T %-7s %3d.%ds exit %-3d %-8s %s: %s\n' "$t0" "$who" $((took / 10)) $((took % 10)) "$status" "$why" "$PWD" "$*" >>"$state/log"
  case $why in
    capped | back | waits) [[ -n $queued ]] || enqueue "$@"; return 75 ;;
    deadline) return 124 ;;
  esac
  return "$status"
}

case ${1:-} in
  --within)
    within || exit 1
    [[ -z ${2:-} ]] && { echo "$max"; exit 0; }
    [[ -z $max ]] && exit 0
    w=${2%x*} h=${2#*x}
    ((w <= ${max%x*} && h <= ${max#*x})) && exit 0
    : >"$runs/$run.waits"
    echo "yield: $2 is more than $max while someone is at the screen" >&2
    exit 75 ;;
  --queue) shift; (($#)) && enqueue "$@"; exit ;;
  --runner)
    while :; do
      next=$(ls "$state/queue" | head -1)
      if [[ -z $next ]] || present; then sleep 60; continue; fi
      mapfile -d '' -t job <"$state/queue/$next"
      (
        cd "${job[0]}" || exit 1
        for name in $(compgen -e); do unset "$name" 2>/dev/null; done
        export "${job[@]:2:job[1]}" 2>/dev/null
        run queued "${job[@]:2+job[1]}"
      ) >>"$state/out/$next" 2>&1 </dev/null
      (($? == 75)) || rm "$state/queue/$next"
    done ;;
  "" | --*) echo "usage: tools/yield [--queue] <command> [args...]" >&2; exit 2 ;;
esac
# Already in a run, a command is that run's.
within && exec "$@"
[[ -n $(ls "$state/queue") ]] && arm
run "" "$@"
