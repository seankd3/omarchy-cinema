#!/usr/bin/env python3
"""After a theme switch, restarts Files when the theme's GTK stylesheet changed,
with its windows open again on the same folders, workspaces and places.

GTK reads ~/.config/gtk-4.0/gtk.css once, when an app starts, and nothing tells
a running app to read it again. A Files that outlives a switch would keep the
last film's look. Each switch records the stylesheet it applied, so the Files
that is running has the one recorded before this switch (it was restarted at
that switch, or started after it); it needs a restart only when that differs
from this switch's. Installed as an Omarchy theme-set hook.
"""

import hashlib
import json
import os
import subprocess
import time
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
CSS = STATE / "omarchy/current/theme/gtk.css"
MARK = STATE / "omarchy-cinema/files-gtk.sha256"


def run(*args):
    return subprocess.run(args, capture_output=True, text=True).stdout


def files_windows():
    """Files' windows as Hyprland shows them."""
    return [c for c in json.loads(run("hyprctl", "clients", "-j") or "[]") if c["class"] == "org.gnome.Nautilus"]


def open_locations():
    """Each Files window's folder, first tab first."""
    out = run("busctl", "--user", "--json=short", "get-property", "org.freedesktop.FileManager1",
              "/org/freedesktop/FileManager1", "org.freedesktop.FileManager1", "OpenWindowsWithLocations")
    windows = json.loads(out)["data"] if out else {}
    return [uris[0] for _, uris in sorted(windows.items()) if uris]


def place(address, where):
    window = f"address:{address}"
    dispatch = lambda expr: run("hyprctl", "dispatch", expr)
    dispatch(f'hl.dsp.window.move({{ workspace = "{where["workspace"]["id"]}", follow = false, window = "{window}" }})')
    if where["floating"]:
        dispatch(f'hl.dsp.window.float({{ action = "on", window = "{window}" }})')
        dispatch(f'hl.dsp.window.resize({{ x = {where["size"][0]}, y = {where["size"][1]}, window = "{window}" }})')
        dispatch(f'hl.dsp.window.move({{ x = {where["at"][0]}, y = {where["at"][1]}, window = "{window}" }})')


def restart():
    locations = open_locations()
    before = files_windows()
    run("nautilus", "-q")
    for _ in range(40):
        if not run("pgrep", "-x", "nautilus"):
            break
        time.sleep(0.1)

    # Windows come back one at a time; each takes the place of the window that
    # showed the same folder (Files titles a window by its folder's name).
    unplaced = list(before)
    for uri in locations:
        seen = {c["address"] for c in files_windows()}
        subprocess.Popen(["nautilus", "--new-window", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(40):
            new = [c for c in files_windows() if c["address"] not in seen]
            if new:
                break
            time.sleep(0.1)
        else:
            continue
        window = new[0]
        match = next((c for c in unplaced if c["title"] == window["title"]), unplaced[0] if unplaced else None)
        if match:
            unplaced.remove(match)
            place(window["address"], match)


def main():
    current = hashlib.sha256(CSS.read_bytes()).hexdigest() if CSS.exists() else ""
    previous = MARK.read_text().strip() if MARK.exists() else None
    MARK.parent.mkdir(parents=True, exist_ok=True)
    MARK.write_text(current + "\n")
    if previous != current and run("pgrep", "-x", "nautilus"):
        restart()


if __name__ == "__main__":
    main()
