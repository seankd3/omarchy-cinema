#!/bin/bash
# Captures each film theme's preview for Omarchy's theme picker from a real
# desktop that is never on screen (tools/hidden-desktop --fresh: a new Omarchy
# user's, so it shows what anyone gets, logged in with the film applied): the
# stock previews' four windows (nvim, btop, a file listing
# and Files, two by two) at their 2560x1440, under the bar.
#
#   tools/theme-previews [slug ...]
#
# Writes themes/<slug>/preview.png, for every film theme unless slugs are given.
set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)

if [[ ${1:-} == --inside ]]; then
  slug=$2 out=$3
  hyprctl plugin list | grep -q '^Plugin backdrop ' || { echo "theme-previews: the backdrop plugin did not load" >&2; exit 1; }

  # Apps start the way Omarchy starts them, from Hyprland, so they have its
  # environment.
  launch() {
    hyprctl eval "hl.exec_cmd([[$1]])" >/dev/null
  }
  open() {
    launch "$2"
    until hyprctl -j clients | jq -e --arg class "$1" 'any(.class == $class)' >/dev/null; do sleep 0.1; done
  }
  focus() {
    hyprctl dispatch "hl.dsp.focus({ window = 'class:^$1\$' })" >/dev/null
  }

  # A home with Files' own folders, and only them.
  mkdir -p ~/{Documents,Downloads,Music,Pictures,Videos}
  # In the sandbox btop reads its battery's time left as 106751991167300d,
  # so the previews show no battery.
  conf=~/.config/btop/btop.conf
  mkdir -p "${conf%/*}" && touch "$conf" && sed -i '/^show_battery *=/d' "$conf" && echo 'show_battery = false' >>"$conf"

  # The stock previews tile, whatever layout the hidden screen's workspace has
  # saved (Omarchy gives each screen its own block of ten). Each new window
  # splits the focused one along its longer side, so the second goes right of
  # the first, and each column then splits in two.
  workspace=$(hyprctl -j activeworkspace | jq -r .id)
  hyprctl eval "o.workspace_mode({ workspace = '$workspace', mode = 'dwindle' })" >/dev/null
  open cinema-nvim "foot --app-id=cinema-nvim -D '$here' nvim --listen '$XDG_RUNTIME_DIR/cinema-nvim' +40 -c 'set splitkeep=cursor' -c 'Neotree show' install"
  open cinema-btop "foot --app-id=cinema-btop btop"
  focus cinema-nvim
  open cinema-ls "foot --app-id=cinema-ls -D '$here' bash -ic 'eza -lh --group-directories-first --icons=auto; exec bash -i'"
  focus cinema-btop
  open org.gnome.Nautilus "nautilus --new-window '$HOME'"
  focus cinema-nvim

  # Long enough for btop to graph a few seconds and the world to come to
  # rest, then until Files has drawn its folders: its window the same in two
  # captures a second apart (a desktop at rest draws nothing; Files' loading
  # spinner turns).
  sleep 6
  # btop shows the whole machine, so other work on it would read as the
  # theme's cost: the capture waits until the machine has been idle for the
  # last 40 s of btop's graph, at most 10% of its CPU time busy in each 2 s
  # btop draws and its load average under 3, however long that takes
  # (tools/yield bounds the run).
  busy() { local s; read -r s </proc/stat; s=(${s#cpu }); echo $((s[0] + s[1] + s[2] + s[5] + s[6] + s[7])) $((s[0] + s[1] + s[2] + s[3] + s[4] + s[5] + s[6] + s[7])); }
  read -r was all < <(busy)
  for ((quiet = 0; quiet < 20;)); do
    sleep 2
    read -r now total < <(busy)
    read -r load _ </proc/loadavg
    (((now - was) * 10 <= total - all && ${load%.*} < 3)) && quiet=$((quiet + 1)) || quiet=0
    was=$now all=$total
  done
  # A new user's first login greets them (Omarchy's first-run notices), and
  # with no network in the sandbox nvim's plugins keep saying they cannot
  # download (noice's message split): neither is the theme, and the notices
  # cover btop.
  omarchy-shell -q notifications dismissAll
  nvim --server "$XDG_RUNTIME_DIR/cinema-nvim" --remote-send "<Cmd>lua for _, w in ipairs(vim.api.nvim_list_wins()) do if vim.api.nvim_win_is_valid(w) and vim.bo[vim.api.nvim_win_get_buf(w)].filetype == 'noice' then pcall(vim.api.nvim_win_close, w, true) end end<CR>" || true
  box=$(hyprctl -j clients | jq -r '.[] | select(.class == "org.gnome.Nautilus") | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
  grim -g "$box" "$out/a.png"
  until sleep 1; grim -g "$box" "$out/b.png"; cmp -s "$out/a.png" "$out/b.png"; do mv "$out/b.png" "$out/a.png"; done
  grim "$out/$slug.png"
  exit
fi

"$here/tools/yield" --within >/dev/null || exec "$here/tools/yield" "$0" "$@"
if (($#)); then
  slugs=("$@")
else
  slugs=()
  for theme in "$here"/themes/*/backdrop.frag; do
    slugs+=("$(basename "$(dirname "$theme")")")
  done
fi

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
for slug in "${slugs[@]}"; do
  [[ -f $here/themes/$slug/backdrop.frag ]] || { echo "theme-previews: $slug is not a film theme" >&2; exit 1; }
  # 1920x1080 a point, the density of the stock previews' text. A film takes
  # about a minute with the new user's first login.
  mkdir "$out/$slug"
  if ! "$here/tools/hidden-desktop" --fresh --size 2560x1440 --scale 1.333333 --theme "$slug" --out "$out/$slug" \
    "$here/tools/theme-previews" --inside "$slug" "$out/$slug"; then
    echo "theme-previews: $slug failed; $out/$slug/hypr.*/*/hyprland.log and desktop.log say what the desktop did" >&2
    trap - EXIT
    exit 1
  fi
  mv "$out/$slug/$slug.png" "$here/themes/$slug/preview.png"
  echo "$here/themes/$slug/preview.png"
done
