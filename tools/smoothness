#!/bin/bash
# How smoothly a film's backdrop moves and what it costs the GPU, measured in
# the hidden desktop: the film (Tron Legacy unless --theme says) with two
# glass terminals, nothing else moving: 12 s of motion after 4 s to settle,
# then 6 s of GPU (sampling it makes the motion less smooth, so not at once).
#
#   tools/smoothness [--rounds N] [--theme SLUG] [--size WxH] [REVISION...]
#
# Each REVISION's plugin is built (once, under plugin/build) and measured on
# this checkout's desktop, themes and tools, round by round, interleaved;
# without one, this checkout as it stands. The desktop is Sean's screen unless
# --size says otherwise (at scale 1); a smaller one keeps the GPU from
# saturating when only the timing is measured. One line per run. On
# frameclock's 60 Hz display a new frame should come every vblank, and the
# backdrop's time in it should be one frame (16.67 ms) on from the last:
#   missed  vblanks with no new frame (it was late, or nothing asked for it)
#   judder  RMS of the step minus 16.67 ms, between frames on consecutive
#           vblanks, so the clock alone and not the missed frames
#   held    of those, frames whose backdrop did not move
#   jumps   of those, frames whose backdrop moved over 1.5 frames
#   speed   the backdrop's time against the display's (1 is right)
#   gpu     the hidden Hyprland's SM share (nvidia-smi pmon) and its GPU ms a
#           frame rendered
#   wait    ms a second the hidden Hyprland waited for a CPU (schedstat)
# Each desktop runs at the lowest CPU and disk priority, under a two and a half
# minute deadline, and holds /tmp/omarchy-cinema-hidden.lock, so only one
# hidden desktop runs on the machine at a time.
set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)

if [[ ${1:-} == --inside ]]; then
  out=$2
  hyprctl plugin list | grep -q '^Plugin backdrop ' || { echo "smoothness: the backdrop plugin did not load" >&2; exit 1; }
  open() {
    hyprctl eval "hl.exec_cmd([[foot --app-id=$1]])" >/dev/null
    until hyprctl -j clients | jq -e --arg class "$1" 'any(.class == $class)' >/dev/null; do sleep 0.1; done
  }
  open glass-a
  open glass-b
  now() { python3 -c 'import time; print(time.monotonic_ns())'; }
  sleep 4
  now >"$out/start"
  sleep 12
  now >"$out/end"
  sleep 6
  now >"$out/gpu"
  # The log has to go on past the end, to show it did not stop before it:
  # frameclock counts a vblank after it.
  until awk -v end="$(cat "$out/gpu")" '$1 == "p" { last = int((end - $3) / $2) + 1 } $1 == "v" && last && $2 > last { found = 1 } END { exit !found }' "$out/frames.log"; do
    sleep 0.05
  done
  exit
fi

rounds=3 theme=tron-legacy size=()
while [[ ${1:-} == --* ]]; do
  case $1 in
    --rounds) rounds=$2 ;;
    --theme) theme=$2 ;;
    --size) size=(--size "$2" --scale 1) ;;
    *) echo "usage: tools/smoothness [--rounds N] [--theme SLUG] [--size WxH] [REVISION...]" >&2; exit 2 ;;
  esac
  shift 2
done

# Each revision's plugin, built from its own plugin/ against the installed
# Hyprland, where the hidden desktop can read it.
sdk=$(sha256sum "$(pkg-config --variable=prefix hyprland)/hyprland/src/version.h" | cut -c1-16)
labels=() plugins=()
for revision in "$@"; do
  commit=$(git -C "$here" rev-parse --short=12 "$revision^{commit}")
  build=$here/plugin/build/$commit-$sdk
  if [[ ! -f $build/backdrop.so ]]; then
    rm -rf "$build"
    mkdir -p "$build/src"
    git -C "$here" archive "$commit" plugin | tar -x -C "$build/src"
    nice -n 19 ionice -c 3 make -s -C "$build/src/plugin" BUILD="$build"
  fi
  labels+=("$revision") plugins+=("$build/backdrop.so")
done
(($#)) || labels=(worktree) plugins=("")

runs=$(mktemp -d)
trap 'rm -rf "$runs"' EXIT
for ((round = 1; round <= rounds; round++)); do
  for i in "${!labels[@]}"; do
    out=$runs/$round-$i
    mkdir "$out"
    plugin=()
    [[ -n ${plugins[i]} ]] && plugin=(--plugin "${plugins[i]}")
    nice -n 19 ionice -c 3 flock /tmp/omarchy-cinema-hidden.lock timeout 150 "$here/tools/hidden-desktop" "${size[@]}" --theme "$theme" \
      "${plugin[@]}" --out "$out" "$here/tools/smoothness" --inside "$out" &
    desktop=$!
    until [[ -s $out/start ]] || ! kill -0 "$desktop" 2>/dev/null; do sleep 0.2; done
    pid=$(pgrep -f -- "-c $here/tools/hidden-desktop.lua" | head -1 || true)
    if [[ -n $pid ]]; then
      read -r _ wait0 _ <"/proc/$pid/schedstat"
      until [[ -s $out/end ]] || ! kill -0 "$desktop" 2>/dev/null; do sleep 0.2; done
      read -r _ wait1 _ <"/proc/$pid/schedstat" || wait1=$wait0
      echo "$pid $(((wait1 - wait0) / 1000000))" >"$out/hyprland"
      timeout 6 nvidia-smi pmon -s u -d 1 >"$out/pmon" 2>/dev/null || true
    fi
    fail() { echo "smoothness: ${labels[i]} round $round $1; see $out" >&2; trap - EXIT; exit 1; }
    wait "$desktop" || fail failed
    python3 - "$out" "$round" "${labels[i]}" <<'EOF' || fail "has no trace of the backdrop"
import bisect, math, sys
out, round_, label = sys.argv[1:]
start, end, gpuEnd = (int(open(f"{out}/{n}").read()) for n in ("start", "end", "gpu"))
period = epoch = None
commits, times = [], []
vblanks = 0
for line in open(f"{out}/frames.log"):
    kind, *rest = line.split()
    if kind == "p":
        period, epoch = int(rest[0]), int(rest[1])
    elif kind == "v":
        vblanks = max(vblanks, int(rest[0]))
    elif kind == "c":
        # A commit within a millisecond of the last is that frame again: a
        # frame takes a whole render.
        if not commits or int(rest[0]) - commits[-1] > 1_000_000:
            commits.append(int(rest[0]))
    elif kind == "t":
        times.append((int(rest[0]), float(rest[1])))
# What each commit shows: the backdrop time drawn last before it. It is on
# screen from the first vblank after it.
shown, t = {}, 0
drawn = None
for c in commits:
    while t < len(times) and times[t][0] <= c:
        drawn = times[t][1]
        t += 1
    if drawn is not None:
        shown[-(-(c - epoch) // period)] = drawn
first, last = -(-(start - epoch) // period), (end - epoch) // period
# The log must cover the run: frameclock counted a vblank after the GPU
# window's end, every frame of the motion window drew the backdrop since the
# frame before it, and a frame was shown before that window began.
inside = [c for c in commits if start <= c <= end]
drawnAt = [at for at, _ in times]
untraced = [b for a, b in zip(inside, inside[1:]) if bisect.bisect_right(drawnAt, b) == bisect.bisect_right(drawnAt, a)]
if period is None or not shown or min(shown) >= first or len(inside) < 2 or untraced or vblanks <= (gpuEnd - epoch) // period + 1:
    sys.exit(1)
p = period / 1e9
vblanks = range(first + 1, last + 1)
on = {}
for k in range(min(shown), last + 1):
    on[k] = shown.get(k, on.get(k - 1))
steps = [shown[k] - shown[k - 1] for k in vblanks if k in shown and k - 1 in shown]
n = len(steps) or 1
missed = 100 * sum(k not in shown for k in vblanks) / len(vblanks)
judder = math.sqrt(sum((s - p) ** 2 for s in steps) / n) * 1000
held = 100 * sum(s == 0 for s in steps) / n
jumps = 100 * sum(s > 1.5 * p for s in steps) / n
speed = (on[last] - on[first]) / (len(vblanks) * p)
rendered = sum(end <= c <= gpuEnd for c in commits) / ((gpuEnd - end) / 1e9)
gpu = wait = float("nan")
try:
    pid, waited = open(f"{out}/hyprland").read().split()
    wait = int(waited) / ((end - start) / 1e9)
    sm = [int(f[3]) for f in (l.split() for l in open(f"{out}/pmon") if not l.startswith("#")) if f[1] == pid and f[3].isdigit()]
    gpu = sum(sm) / len(sm) if sm else float("nan")
except FileNotFoundError:
    pass
print(f"round {round_} {label:<12} missed {missed:4.1f}%  judder {judder:5.2f} ms  held {held:4.1f}%  jumps {jumps:4.1f}%  "
      f"speed {speed:5.3f}  gpu {gpu:4.1f}% {gpu / 100 * 1000 / rendered if rendered else float('nan'):5.2f} ms/frame ({rendered:.0f} rendered/s)  wait {wait:5.1f} ms/s")
EOF
  done
done
