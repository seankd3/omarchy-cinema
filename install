#!/bin/bash
# Builds the backdrop plugin for the installed Hyprland and links the themes
# into Omarchy. Run it again after changing the plugin and after every Hyprland
# update: the plugin refuses to load into a Hyprland it was not built for.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)

make -s -C "$here/plugin" BUILD="$here/plugin/build"
mkdir -p ~/.local/lib/omarchy-cinema
# A new file, not an overwrite: Hyprland has the old one mapped while it runs.
install -m 755 "$here/plugin/build/backdrop.so" ~/.local/lib/omarchy-cinema/backdrop.so.new
mv ~/.local/lib/omarchy-cinema/backdrop.so.new ~/.local/lib/omarchy-cinema/backdrop.so

# A link never replaces a real directory: the user's own theme of the same
# name stays, and the install stops.
mkdir -p ~/.config/omarchy/themes
for theme in "$here"/themes/*/; do
  target=~/.config/omarchy/themes/$(basename "$theme")
  if [[ -e $target && ! -L $target ]]; then
    echo "$target exists and is not a link; move it aside first" >&2
    exit 1
  fi
  ln -sfn "${theme%/}" "$target"
done
