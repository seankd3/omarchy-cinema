#!/bin/bash
# Builds the backdrop plugin for the installed Hyprland and links the themes
# into Omarchy. Run it again after changing anything and after every Hyprland
# update: the plugin refuses to load into a Hyprland it was not built for.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)

# The headers' version file names the Hyprland they describe (version and
# commit), so its hash names the build; timestamps would not tell an update.
sdk=$(sha256sum "$(pkg-config --variable=prefix hyprland)/hyprland/src/version.h" | cut -c1-16)
make -s -C "$here/plugin" BUILD="$here/plugin/build/$sdk"
mkdir -p ~/.local/lib/omarchy-cinema
# A new file, not an overwrite: Hyprland has the old one mapped while it runs.
install -m 755 "$here/plugin/build/$sdk/backdrop.so" ~/.local/lib/omarchy-cinema/backdrop.so.new
mv ~/.local/lib/omarchy-cinema/backdrop.so.new ~/.local/lib/omarchy-cinema/backdrop.so
# Every film theme's hyprland.lua runs this.
install -m 644 "$here/film.lua" ~/.local/lib/omarchy-cinema/film.lua

# A link never replaces a real directory or file: the user's own theme of the
# same name stays, and the install stops.
link() {
  if [[ -e $2 && ! -L $2 ]]; then
    echo "$2 exists and is not a link; move it aside first" >&2
    exit 1
  fi
  ln -sfn "$1" "$2"
}

# Each theme's folder icons are an icon theme of their own. GTK finds it by
# its directory name; the theme's icons.theme names it, and Omarchy sets it.
mkdir -p ~/.config/omarchy/themes ~/.local/share/icons
for theme in "$here"/themes/*/; do
  theme=${theme%/}
  # A film still being built stays out of Omarchy's theme list until it has
  # everything a film theme has.
  missing=""
  for file in colors.toml hyprland.lua backdrop.frag gtk.css shell.bar.toml folders.json; do
    [[ -f $theme/$file ]] || missing+=" $file"
  done
  if [[ -n $missing ]]; then
    echo "skipped $(basename "$theme"): no$missing" >&2
    continue
  fi
  icons=$(python3 "$here/tools/folders.py" "$theme")
  link "$theme/icons" ~/.local/share/icons/"$icons"
  # A film's dictation popup builds on FilmOsd, which must sit beside it:
  # Omarchy copies the theme on its own when it applies it.
  [[ -f $theme/voxtype-osd.toml ]] && install -m 644 "$here/osd/FilmOsd.qml" "$theme/FilmOsd.qml"
  link "$theme" ~/.config/omarchy/themes/"$(basename "$theme")"
done

# GTK reads one stylesheet per user. It imports the applied theme's, which a
# film theme ships and every other theme gets empty from this template, so a
# stock theme looks as it always has.
template=~/.config/omarchy/themed/gtk.css.tpl
if [[ ! -e $template ]]; then
  mkdir -p "${template%/*}"
  printf '/* No GTK styling of its own: film themes ship a gtk.css. */\n' >"$template"
fi
import='@import url("file://'"$HOME"'/.local/state/omarchy/current/theme/gtk.css");'
gtk=~/.config/gtk-4.0/gtk.css
mkdir -p "${gtk%/*}"
touch "$gtk"
if ! grep -qxF "$import" "$gtk"; then
  printf '%s\n%s' "$import" "$(cat "$gtk")" >"$gtk"
fi

# Voxtype's dictation popup follows the theme the same way: its style is the
# applied theme's voxtype-osd.toml, which a film theme ships with its own
# popup and every other theme gets from this template, keeping Voxtype's.
# Voxtype re-reads it when the theme changes, so the popup switches with it.
template=~/.config/omarchy/themed/voxtype-osd.toml.tpl
[[ -e $template ]] || install -m 644 "$here/osd/voxtype-osd.toml.tpl" "$template"

# The applied theme was copied before this ran and may lack its popup, and
# Voxtype's OSD will not start on a style that is not there: give it what
# Omarchy gives it at the next switch.
current=~/.local/state/omarchy/current/theme
applied=~/.config/omarchy/themes/$(cat ~/.local/state/omarchy/current/theme.name 2>/dev/null)
if [[ -d $current ]]; then
  if [[ -f $applied/voxtype-osd.toml ]]; then
    install -m 644 "$applied"/voxtype-osd.toml "$applied"/voxtype-osd-*.qml "$applied"/FilmOsd.qml "$current/"
  elif [[ ! -f $current/voxtype-osd.toml ]]; then
    install -m 644 "$template" "$current/voxtype-osd.toml"
  fi
fi

# Voxtype's settings for that, changed only where they differ: its style is
# the applied theme, drawn by its Quickshell OSD, and nothing pins it to one
# look (a plugin path wins over the style; a palette other than Omarchy's
# stops it following the theme). Voxtype reads them when it starts.
if command -v voxtype >/dev/null; then
  if [[ -d ${XDG_DATA_HOME:-$HOME/.local/share}/voxtype/quickshell || -d /usr/share/voxtype/quickshell ]]; then
    changed=""
    setting() {
      [[ $(voxtype config get "$1") == "$2" ]] && return
      if [[ $2 == null ]]; then voxtype config unset "$1" >/dev/null; else voxtype config set "$1" "$2" >/dev/null; fi
      changed+=" $1"
    }
    setting osd.style "~/.local/state/omarchy/current/theme"
    setting osd.frontend quickshell
    setting osd.plugin_path null
    [[ $(voxtype config get osd.palette) == omarchy ]] || setting osd.palette null
    if [[ -n $changed ]]; then
      echo "Voxtype's popup follows the theme once Voxtype restarts (changed$changed): systemctl --user restart voxtype" >&2
    fi
  else
    echo "Voxtype's Quickshell OSD is not installed, so its popup stays as it is: run voxtype setup quickshell, then ./install" >&2
  fi
fi

# Omarchy runs this after `omarchy update`: the plugin is rebuilt for the
# Hyprland just installed (Sean, 2026-10-28). It loads at the next login.
hook=~/.config/omarchy/hooks/post-update.d/omarchy-cinema-rebuild
mkdir -p "${hook%/*}"
printf '#!/bin/bash\n# Rebuilds the backdrop plugin for the Hyprland just installed.\nexec %q\n' "$here/install" >"$hook"
chmod 755 "$hook"
