  "css": ":root{--surface-grain:none;--glass-opacity:100%!important}\n*,::before,::after{--tw-shadow:0 0 #0000!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}\n::selection{background:#cde4f3}\nsvg.lucide{stroke-width:1.75}\n[data-slot$=\"-popup\"]{--background:var(--popover);--popup-edge:color-mix(in srgb,var(--foreground) 16%,var(--popover));border-color:var(--popup-edge)!important;box-shadow:none!important}\n[data-slot=select-popup]>*{border-color:var(--popup-edge)!important}\n[data-slot$=\"dialog-footer\"],[data-slot=command-footer]{background:none!important;border-color:var(--popup-edge)!important}\n[data-slot$=\"-backdrop\"]{background:none!important}\n[class*=\"backdrop-blur\"][class*=\"bg-background/\"]:not([data-slot$=\"-backdrop\"]){background-color:var(--background)!important}\n[class*=\"backdrop-blur\"][class*=\"bg-popover/\"]{background-color:var(--popover)!important}\n[class*=\"backdrop-blur\"][class*=\"bg-muted/\"]{background-color:var(--muted)!important}\n.dark [class~=\"bg-destructive\"]{color:color-mix(in srgb,var(--error) 12%,#000)!important}\n"
